{
  "name": "digital-agency-icons",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Agency Icons - Official icon library for Japanese government services",
  "scripts": {
    "prepare": "lefthook install",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm --filter @digital-agency-icons/docs dev",
    "check": "vp check && pnpm -r type-check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "format": "vp fmt --check .",
    "format:fix": "vp fmt .",
    "type-check": "pnpm -r type-check",
    "lint:packages": "pnpm --filter \"./packages/*\" lint:package",
    "test": "pnpm build:packages && vp test",
    "test:only": "vp test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "jsdom": "30.1.2",
    "lefthook": "2.1.17",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vite-plus": "1.0.0"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12.10.0"
  },
  "packageManager": "pnpm@12.10.1"
}
