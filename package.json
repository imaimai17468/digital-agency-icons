{
  "name": "digital-agency-icons",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Agency Icons - Official icon library for Japanese government services",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm --filter @digital-agency-icons/docs dev",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12.10.0"
  }
}
