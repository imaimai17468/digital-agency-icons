{
  "name": "@imaimai17468/digital-agency-icons-core",
  "version": "0.0.5",
  "description": "Core SVG data and utilities for Digital Agency Icons",
  "keywords": [
    "digital-agency",
    "government",
    "icons",
    "japan",
    "svg"
  ],
  "homepage": "https://github.com/imaimai17468/digital-agency-icons#readme",
  "bugs": {
    "url": "https://github.com/imaimai17468/digital-agency-icons/issues"
  },
  "license": "MIT",
  "author": "Digital Agency Icons Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imaimai17468/digital-agency-icons.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/build.ts && tsc",
    "dev": "tsx scripts/build.ts --watch",
    "type-check": "tsc --noEmit",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
