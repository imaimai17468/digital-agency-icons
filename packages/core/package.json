{
  "name": "@imaimai17468/digital-agency-icons-core",
  "version": "0.0.3",
  "description": "Core SVG data and utilities for Digital Agency Icons",
  "keywords": [
    "digital-agency",
    "government",
    "icons",
    "japan",
    "svg"
  ],
  "homepage": "https://github.com/imaimai17468/digital-agency-icons#readme",
  "bugs": {
    "url": "https://github.com/imaimai17468/digital-agency-icons/issues"
  },
  "license": "MIT",
  "author": "Digital Agency Icons Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/imaimai17468/digital-agency-icons.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./icons": {
      "import": "./dist/icons/index.js",
      "types": "./dist/icons/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/build.ts && tsc",
    "dev": "tsx scripts/build.ts --watch",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
