{
  "name": "@imaimai17468/digital-agency-icons-svelte",
  "version": "0.0.2",
  "description": "Svelte components for Digital Agency Icons",
  "keywords": [
    "components",
    "digital-agency",
    "government",
    "icons",
    "japan",
    "svelte"
  ],
  "homepage": "https://github.com/imaimai17468/digital-agency-icons#readme",
  "bugs": {
    "url": "https://github.com/imaimai17468/digital-agency-icons/issues"
  },
  "license": "MIT",
  "author": "Digital Agency Icons Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imaimai17468/digital-agency-icons.git",
    "directory": "packages/svelte"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "svelte": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/generate.ts",
    "dev": "tsx scripts/generate.ts --watch",
    "type-check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@imaimai17468/digital-agency-icons-core": "workspace:^"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "svelte4": "npm:svelte@4.2.20",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  }
}
